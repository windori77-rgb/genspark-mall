{
  "version": "0.2.0",
  "configurations": [
    {
      // ── ① 기본: 로컬 개발 서버 (안전) ──────────────────────────
      // localhost 로 접속하면 src/lib/env.ts 가 자동으로 "local" 로 판정하여
      // /api/* 프록시를 끄고 내 PC 의 로컬 SQLite(.wrangler/state)만 사용한다.
      // → 상품 수정/주문 삭제를 마음껏 테스트해도 운영 DB 는 그대로다.
      "name": "① dev (로컬 DB · 안전)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      // Windows 에서는 npm 이 npm.cmd 셔틀(.cmd)이라 그대로는 못 찾는 경우가 있다.
      "windows": { "runtimeExecutable": "npm.cmd" },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // ── ② 빌드 결과물을 wrangler 로 실행 (Worker 환경 재현) ─────
      // vite dev 와 달리 실제 Workers 런타임(miniflare)에서 돌려본다.
      // D1 바인딩/서비스워커/PWA 동작까지 확인할 때 사용.
      "name": "② preview (wrangler · 로컬 D1)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler", "pages", "dev", "dist",
        "--d1=webapp-production", "--local",
        "--ip", "127.0.0.1", "--port", "8788"
      ],
      "windows": { "runtimeExecutable": "npx.cmd" },
      "console": "integratedTerminal",
      "preLaunchTask": "build",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": []
}
