{
  "name": "webapp",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=webapp-production --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1=webapp-production --local",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','.wrangler'])fs.rmSync(d,{recursive:true,force:true});console.log('cleaned: dist, .wrangler')\"",
    "deploy": "node scripts/deploy-guard.mjs",
    "deploy:cf": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
